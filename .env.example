# Copy to .env (git-ignored). Vyron loads this file at startup if it exists.
ANTHROPIC_API_KEY=sk-ant-...
# Tier 3 (voice) — optional until you use --voice
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional: watch Gmail (read-only). GMAIL_APP_PASSWORD is a Google "app password",
# not your normal password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: phone notifications via the ntfy app. Subscribe to this topic name in the app.
NTFY_TOPIC=
